# LeetCoach Environment Variables Configuration Example
# Copy this file to .env before starting the backend server

# Server Port
PORT=3000

# PostgreSQL Connection String (Database + pgvector)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/leetcoach

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# AI API Keys (For Milestone 4 RAG & Vector Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Node Environment
NODE_ENV=development
